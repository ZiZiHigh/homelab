# Copy this file to monitoring/.env on the host.
# Never commit the real .env file.
# Generate a strong value with: openssl rand -base64 32
# The real file must be mode 600 and owned by the user running compose.
#
# The Grafana container reads this value as GF_SECURITY_ADMIN_PASSWORD.
# Do not use the Grafana default password.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=__GENERATE_WITH_OPENSSL_RAND_BASE64_32__
