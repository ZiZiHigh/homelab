[Unit]
Description=Homelab mDNS alias %i.local
After=avahi-daemon.service network-online.target
Wants=network-online.target
Requires=avahi-daemon.service

[Service]
Type=simple
ExecStart=/usr/bin/avahi-publish-address -a -R %i.local 192.0.2.10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
